// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    spawn-at-startup "noctalia"
    // 启动后备隐藏能源！
    spawn-at-startup "sh" "-c" "[ -f \"${XDG_STATE_HOME:-$HOME/.local/state}/ZEKniri/waybar-enabled\" ] || exit 0; systemctl --user start waybar.service 2>/dev/null || exec waybar"
    spawn-at-startup "mark-shot"
    // 启动后备隐藏能源！
    spawn-at-startup "sh" "-c" "[ -f \"${XDG_STATE_HOME:-$HOME/.local/state}/ZEKniri/watcher-enabled\" ] || exit 0; systemctl --user start zekniri-watch.service 2>/dev/null || exec \"$HOME/.local/bin/ZEK-niri\" watch"
