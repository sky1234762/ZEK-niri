{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
        "source": "arch",
        "color": {
            "1": "red",
            "2":"yellow"
       }
    },
    "display": {
        "separator": " -> ",
        "color": {
            "separator": "red"
        }
    },
    "modules": [
        {
            "type": "title"
        },
        {
            "type": "kernel",
            "key": "Arch Linux  ",
            "keyColor": "magenta"
        },
        {
            "key": "Host        ",
            "type": "host"
        },
        {
            "key": "Shell       ",
            "type": "shell"
        },
        {
            "key": "Terminal    ",
            "type": "terminal"
        },
        {
            "type": "terminalfont",
            "key": "Font        ",
         },
        {
            "key": "Display     ",
            "type": "display"
        },
        {
            "type": "cpu",
            "key": "CPU         ",
        },
        {
            "type": "gpu",
            "key": "GPU         ",
        },
        {
            "type": "memory",
            "key": "RAM         ",
        },
        {
            "type": "disk",
            "key": "Disk        ",
        },
        {
            "key": "Backlight   ",
            "type": "brightness"
        },
        {
            "type": "WM",
            "key": "desktop     ",
        },
        {
            "key": "Peripherals ",
            "type": "mouse",
            "timeout": 500
        },
        {
            "type": "media",
            "key": "NOW PLAYING ",
            "format": "{?artist}{artist} - {?}{title}",
            "keyColor": "cyan"
        },
         "break",
        {
            "type": "colors",
            "paddingLeft": 6,
            "symbol": "circle"
        }
    ]
}
