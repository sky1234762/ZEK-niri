# ---------------------------------------------------------------------------
# curses TUI
# ---------------------------------------------------------------------------

def run_tui(client, info):
    lines = []                       # [(style, text)]
    lock = threading.Lock()
    inq = queue.Queue()
    stop = threading.Event()
    state = {
        "title": info.get("title") or "",
        "online": "",
        "watched": "",
        "live": info.get("live_status", 0),
        "count": 0,
    }

    def on_message(style, text):
        inq.put(("msg", style, text))

    def on_meta(key, value):
        inq.put(("meta", key, value))

    def worker():
        try:
            client.run(lambda s, t: on_message(s, t), on_meta)
        except Exception as exc:      # noqa
            inq.put(("meta", "error", str(exc)))
        finally:
            inq.put(("meta", "disconnected", True))

    thread = threading.Thread(target=worker, daemon=True)
    thread.start()

    def draw(stdscr, scroll):
        h, w = stdscr.getmaxyx()
        stdscr.erase()
        live = "直播中" if state["live"] == 1 else "未开播"
        top = " %s · %s · 在线 %s · 已收 %d 条 " % (
            state["title"][:24], live, state["online"] or "-", state["count"])
        try:
            stdscr.addstr(0, 0, top[:w - 1], curses.A_BOLD | curses.A_REVERSE)
        except curses.error:
            pass
        body_h = h - 2
        end = len(lines) - scroll
        start = max(0, end - body_h)
        shown = lines[start:end]
        for i, (style, text) in enumerate(shown):
            color = {"danmaku": 1, "gift": 2, "sc": 3,
                     "interact": 4, "system": 5, "error": 3}.get(style, 1)
            try:
                stdscr.addstr(1 + i, 0, text[:w - 1],
                              curses.color_pair(color))
            except curses.error:
                pass
        hint = " q 退出   ↑/↓ PgUp/PgDn 滚动   End 回底部"
        if scroll:
            hint = " [已上滚 %d 行]" % scroll + hint
        try:
            stdscr.addstr(h - 1, 0, hint[:w - 1], curses.A_DIM)
        except curses.error:
            pass
        stdscr.refresh()

    def _main(stdscr):
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_WHITE, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_MAGENTA, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.init_pair(5, curses.COLOR_GREEN, -1)
        curses.curs_set(0)
        stdscr.keypad(True)
        stdscr.timeout(80)
        scroll = 0
        while not stop.is_set():
            # 收消息
            got = 0
            while got < 1000:
                try:
                    item = inq.get_nowait()
                except queue.Empty:
                    break
                got += 1
                if item[0] == "msg":
                    _, style, text = item
                    with lock:
                        lines.append((style, text))
                        state["count"] += 1
                    if not scroll:
                        pass
                else:
                    _, key, value = item
                    if key == "online":
                        state["online"] = value
                    elif key == "watched":
                        state["watched"] = value
                    elif key == "popularity":
                        state["online"] = value
                    elif key == "error":
                        with lock:
                            lines.append(("error", "!! %s" % value))
                    elif key == "disconnected":
                        with lock:
                            lines.append(("system", "· 连接已断开（按 q 退出）"))
            with lock:
                if len(lines) > 3000:
                    del lines[:len(lines) - 3000]
            draw(stdscr, scroll)
            k = stdscr.getch()
            if k in (ord('q'), ord('Q')):
                break
            elif k == curses.KEY_UP:
                scroll = min(scroll + 1, max(0, len(lines) - 1))
            elif k == curses.KEY_DOWN:
                scroll = max(scroll - 1, 0)
            elif k == curses.KEY_PPAGE:
                hh, _ = stdscr.getmaxyx()
                scroll = min(scroll + max(1, hh - 2), max(0, len(lines) - 1))
            elif k == curses.KEY_NPAGE:
                hh, _ = stdscr.getmaxyx()
                scroll = max(scroll - max(1, hh - 2), 0)
            elif k == curses.KEY_END:
                scroll = 0

    try:
        curses.wrapper(_main)
    finally:
        stop.set()
        client.stop()


# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

def main(argv=None):
    try:
        sys.stdout.reconfigure(line_buffering=True)   # 便于管道/日志实时看到文本
    except Exception:
        pass
    parser = argparse.ArgumentParser(
        prog="ZEK-danmaku",
        description="实时查看 B 站直播间弹幕（纯标准库实现）",
    )
    parser.add_argument("--room", help="房间号（默认当前登录账号的直播间）")
    parser.add_argument("--plain", action="store_true",
                        help="纯文本逐行输出，不用全屏 TUI")
    parser.add_argument("--version", action="version", version=__version__)
    args = parser.parse_args(argv)

    cookies = load_cookies()
    try:
        room = resolve_room(args, cookies)
    except ToolError as exc:
        print(red("错误：%s" % exc.message))
        if exc.hint:
            print(yellow("  " + exc.hint))
        return 1

    info = room_info(room, cookies)
    client = DanmakuClient(room, cookies)
    try:
        client.prepare()
    except ToolError as exc:
        print(red("错误：%s" % exc.message))
        if exc.hint:
            print(yellow("  " + exc.hint))
        return 1
    try:
        client.connect()
    except ToolError as exc:
        print(red("连接弹幕服务器失败：%s" % exc.message))
        return 1

    print("已连接弹幕服务器 %s · 房间 %s%s"
          % (client.host["host"], room,
             "（游客）" if not client.uid else ""))
    if not brotli:
        print(yellow("提示：未装 brotli，已用 zlib 兼容模式。"))

    if args.plain:
        run_plain(client, info)
        return 0

    run_tui(client, info)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
