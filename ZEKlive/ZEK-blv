def _draw_menu(stdscr, streamer, idx):
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    status = ("● 推流中（已 %s）" % fmt_duration(streamer.uptime())
              if streamer.alive() else "● 未推流")
    try:
        stdscr.addstr(0, 0, status[:w - 1], curses.A_BOLD | curses.A_REVERSE)
    except curses.error:
        pass
    try:
        stdscr.addstr(1, 0, "列位诸公，今天我们播什么？ 是啊，播什么", curses.A_BOLD)
    except curses.error:
        pass
    for i, (label, _) in enumerate(MENU):
        y = 3 + i
        if y >= h - 1:
            break
        num = str(i + 1 if i < 9 else 0)
        text = "  %s. %s" % (num, label)
        try:
            if i == idx:
                stdscr.addstr(y, 0, text[:w - 1], curses.A_REVERSE)
            else:
                stdscr.addstr(y, 0, text[:w - 1])
        except curses.error:
            pass
    try:
        hint = " ↑/↓ 或 j/k 移动   Enter 确认   q 退出   数字键直接选  "
        stdscr.addstr(h - 1, 0, hint[:w - 1], curses.A_DIM)
    except curses.error:
        pass
    stdscr.refresh()


def curses_menu(streamer, initial_idx=0):
    """全屏菜单，方向键选择。返回 (action_key, new_idx)。"""
    result = {}

    def _main(stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        idx = initial_idx
        while True:
            _draw_menu(stdscr, streamer, idx)
            k = stdscr.getch()
            if k in (curses.KEY_UP, ord('k'), ord('K')):
                idx = (idx - 1) % len(MENU)
            elif k in (curses.KEY_DOWN, ord('j'), ord('J')):
                idx = (idx + 1) % len(MENU)
            elif k == curses.KEY_HOME:
                idx = 0
            elif k == curses.KEY_END:
                idx = len(MENU) - 1
            elif k in (curses.KEY_ENTER, 10, 13, ord(' ')):
                result['action'] = MENU[idx][1]
                result['idx'] = idx
                return
            elif k in (ord('q'), ord('Q')):
                result['action'] = 'quit'
                result['idx'] = idx
                return
            elif ord('1') <= k <= ord('9'):
                i = k - ord('1')
                if i < len(MENU):
                    result['action'] = MENU[i][1]
                    result['idx'] = i
                    return
            elif k == ord('0'):
                result['action'] = 'quit'
                result['idx'] = len(MENU) - 1
                return

    curses.wrapper(_main)
    return result.get('action'), result.get('idx', initial_idx)


def run_menu(ctl, streamer, cfg):
    actions = {
        "login": lambda: action_login(ctl),
        "status": lambda: action_status(ctl),
        "update": lambda: action_update(ctl),
        "start": lambda: action_start(ctl, streamer, cfg),
        "show": lambda: action_show_stream(streamer),
        "stop": lambda: action_stop(ctl, streamer),
        "settings": lambda: action_settings(cfg),
        "check": lambda: action_check(cfg),
        "logout": lambda: action_logout(ctl),
    }
    idx = 0
    while True:
        action, idx = curses_menu(streamer, idx)
        if action == "quit":
            if streamer.alive():
                print(yellow("还在推流，确定退出？会自动停止推流但不主动下播。"))
                ans = input(bold("退出并停止推流？（y/N）：") + " ").strip().lower()
                if ans != "y":
                    continue
                streamer.stop()
                streamer.release_portal()
            print("已退出")
            break
        if action and action in actions:
            try:
                actions[action]()
            except ToolError as exc:
                print(red("出错：%s" % exc.message))
                if exc.hint:
                    print(yellow("  " + exc.hint))
            except KeyboardInterrupt:
                print("\n已取消。")
            # 暂停，让用户看清输出后再回菜单
            try:
                input(bold("\n按回车返回菜单…") + " ")
            except (KeyboardInterrupt, EOFError):
                print()


# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="ZEK-blv",
        description="在 Linux (Wayland/niri) 上开 B 站直播的交互式工具",
    )
    parser.add_argument("--check", action="store_true", help="自检依赖与环境后退出")
    parser.add_argument("--version", action="version", version=__version__)
    args = parser.parse_args(argv)

    cfg = load_config()

    if args.check:
        action_check(cfg)
        return 0

    script = find_script(cfg)
    if not script:
        print(red("喂，你这家伙挪文件挪的很开心嘛"))
        print(yellow("给我把它放到正确路径啊（恼）"))
        print(yellow("改之前设环境变量也可以： BILI_LIVE_STREAM_BIN=/path/to/script"))
        print(yellow("先用 --check 查看详情罢（无慈悲）"))
        return 1

    ctl = BiliControl(script)
    streamer = Streamer()

    try:
        run_menu(ctl, streamer, cfg)
    except KeyboardInterrupt:
        pass
    finally:
        if streamer.alive():
            streamer.stop()
        streamer.release_portal()
    return 0


if __name__ == "__main__":
    sys.exit(main())
