def _terminal_graphics_format():
    """返回终端支持的像素图形协议：kitty / sixels / iterm，都不支持返回 None。"""
    term = (os.environ.get("TERM") or "").lower()
    prog = (os.environ.get("TERM_PROGRAM") or "").lower()
    if os.environ.get("KITTY_WINDOW_ID") or "kitty" in term or "ghostty" in (term + prog):
        return "kitty"
    if any(k in term for k in ("sixel", "foot", "mlterm", "contour", "yaft")) \
            or "wezterm" in prog:
        return "sixels"
    if "iterm" in (term + prog):
        return "iterm"
    return None


def show_qr(path):
    if not path or not os.path.exists(path):
        print(yellow("（二维码图片不存在：%s）" % path))
        return

    chafa = which("chafa")

    # 1) 终端支持像素图形协议（kitty / sixel / iTerm2）→ 高清内联显示
    fmt = _terminal_graphics_format()
    if fmt and chafa:
        r = sh([chafa, "--format", fmt, "--size", "40x20", path])
        if r.returncode == 0 and r.stdout.strip():
            print(r.stdout.rstrip("\n"))
            print(cyan("↑ 用 App 扫这个二维码"))
            print(cyan("  图片文件：%s" % path))
            return

    # 2) 没有图形协议 → 直接打开图片查看器
    viewer = which("feh") or which("mpv") or which("xdg-open")
    if viewer:
        if os.path.basename(viewer) == "mpv":
            args = [viewer, "--force-window=yes",
                    "--image-display-duration=inf", path]
        else:
            args = [viewer, path]
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(cyan("已用图片查看器打开二维码：%s" % path))
        return

    # 3) 兜底：字符画
    if chafa:
        r = sh([chafa, "--format", "symbols", "--symbols", "block",
                "--colors", "2", "--size", "40x20", path])
        if r.returncode == 0 and r.stdout.strip():
            print(r.stdout.rstrip("\n"))
            print(cyan("↑ 二维码图片：%s" % path))
            return

    print(cyan("二维码图片路径：%s（请自行打开）" % path))


# ---------------------------------------------------------------------------
# xdg-desktop-portal ScreenCast（Wayland 屏幕采集）
# ---------------------------------------------------------------------------

def portal_screencast(capture="monitor", timeout=120):
    """通过 portal 拿到 PipeWire 采集 fd 与节点 id。

    返回 (fd, node_id, session_handle, bus)。fd 需要调用方保持打开。

    xdg-desktop-portal 1.22 的实际流程：CreateSession / SelectSources /
    Start 都先同步返回一个 request handle，真正的结果（session_handle、
    streams）通过该 request 对象上的 Response 信号异步送达。
    """
    try:
        import dbus
        import dbus.mainloop.glib
        dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
        from gi.repository import GLib
    except ImportError as exc:
        raise ToolError("缺少 dbus / gi (PyGObject)：%s" % exc,
                        hint="安装 python-dbus 和 python-gobject。")

    bus = dbus.SessionBus()
    desktop = bus.get_object("org.freedesktop.portal.Desktop",
                             "/org/freedesktop/portal/desktop")
    sc = dbus.Interface(desktop, "org.freedesktop.portal.ScreenCast")

    token = "zek_blv_%d_%d" % (os.getpid(), int(time.time() * 1000))

    def wait_response(request_path):
        """监听指定 request 对象上的 Response 信号。"""
        holder = {}
        loop = GLib.MainLoop()

        def on_response(response, results):
            holder["response"] = int(response)
            holder["results"] = dict(results) if results else {}
            loop.quit()

        recv = bus.add_signal_receiver(
            on_response,
            signal_name="Response",
            dbus_interface="org.freedesktop.portal.Request",
            path=request_path,
        )

        def on_timeout():
            loop.quit()
            return False

        GLib.timeout_add_seconds(timeout, on_timeout)
        loop.run()
        recv.remove()
        if "response" not in holder:
            raise ToolError(
                "portal 请求超时（%ds）。是否没在弹出的对话框里选择屏幕/窗口？" % timeout)
        return holder["response"], holder["results"]

    # 1) CreateSession：同步返回 request handle，Response 里带 session_handle
    req = sc.CreateSession({
        "handle_token": token + "_s",
        "session_handle_token": token + "_sess",
    })
    resp, results = wait_response(req)
    if resp != 0:
        raise ToolError("portal CreateSession 失败 (code=%d)" % resp)
    session_handle = results.get("session_handle")
    if not session_handle:
        raise ToolError("portal CreateSession 没返回 session_handle")

    # 2) SelectSources：选择要采集的源（弹出屏幕/窗口选择对话框）
    types = dbus.UInt32(1 if capture == "monitor" else 2)
    req = sc.SelectSources(session_handle, {
        "handle_token": token + "_sel",
        "types": types,
        "multiple": dbus.Boolean(False),
        "cursor_mode": dbus.UInt32(2),   # 2 = 嵌入光标
    })
    resp, _ = wait_response(req)
    if resp != 0:
        raise ToolError("portal SelectSources 被取消或失败 (code=%d)" % resp)

    # 3) Start：开始采集，Response 里带 streams（节点列表）
    req = sc.Start(session_handle, "", {"handle_token": token + "_start"})
    resp, results = wait_response(req)
    if resp != 0:
        raise ToolError("portal Start 失败 (code=%d)" % resp)
    streams = results.get("streams") or []
    if not streams:
        raise ToolError("portal 没返回可用的采集节点")
    # streams 形如 [(uint32 node_id, a{sv} properties), ...]
    node_id = int(streams[0][0])

    # 4) OpenPipeWireRemote：同步直接返回 PipeWire remote 的 fd
    fd_obj = sc.OpenPipeWireRemote(session_handle, {})
    # python-dbus 的 UnixFd 不支持 int()，用 take() 取出 fd 整数并接管所有权
    fd = fd_obj.take()

    return fd, node_id, session_handle, bus


def close_portal_session(bus, session_handle):
    try:
        obj = bus.get_object("org.freedesktop.portal.Desktop", session_handle)
        iface = dbus_interface(obj)
        iface.Close()
    except Exception:
        pass


def dbus_interface(obj):
    import dbus
    return dbus.Interface(obj, "org.freedesktop.portal.Session")


# ---------------------------------------------------------------------------
# 屏幕 / 音频设备探测
# ---------------------------------------------------------------------------

def detect_screen_size():
    """返回 (w, h)。优先 niri msg -j outputs，其次 xrandr。"""
    niri = which("niri")
    if niri:
        r = sh([niri, "msg", "-j", "outputs"])
        if r.returncode == 0:
            try:
                outputs = json.loads(r.stdout)
                if isinstance(outputs, dict):
                    for out in outputs.values():
                        modes = out.get("modes") or []
                        idx = out.get("current_mode")
                        if isinstance(idx, int) and 0 <= idx < len(modes):
                            return int(modes[idx]["width"]), int(modes[idx]["height"])
                        lg = out.get("logical") or {}
                        if lg.get("width") and lg.get("height"):
                            return int(lg["width"]), int(lg["height"])
                elif isinstance(outputs, list):
                    for out in outputs:
                        mode = out.get("current_mode") or {}
                        if mode.get("width") and mode.get("height"):
                            return int(mode["width"]), int(mode["height"])
            except (ValueError, KeyError, TypeError):
                pass
    xrandr = which("xrandr")
    if xrandr:
        out = sh_out(["xrandr"])
        m = re.search(r"current\s+(\d+)\s+x\s+(\d+)", out)
        if m:
            return int(m.group(1)), int(m.group(2))
    return None


def compute_resolution(cfg):
    """根据配置里的目标宽度，按屏幕宽高比算出目标高度（偶数）。"""
    width = int(cfg["video"].get("width") or 0)
    if width <= 0:
        width = 1280
    size = detect_screen_size()
    if size:
        sw, sh = size
        height = round(width * sh / sw / 2) * 2
    else:
        height = round(width * 9 / 16 / 2) * 2
    return width, max(height, 2)


def pulse_device(kind):
    """返回 ffmpeg -f pulse 用的设备名。"""
    if kind == "mic":
        src = sh_out(["pactl", "get-default-source"])
        return src or "default"
    if kind == "desktop":
        sink = sh_out(["pactl", "get-default-sink"])
        return (sink + ".monitor") if sink else "default"
    return None


def detect_encoders():
    out = sh_out(["ffmpeg", "-hide_banner", "-encoders"])
    encs = []
    for name in ("libx264", "h264_nvenc", "h264_vaapi"):
        if name in out:
            encs.append(name)
    return encs or ["libx264"]


# ---------------------------------------------------------------------------
# OBS 集成：niri 的 PipeWire screencast 只提供 DMA-BUF 格式，gst-pipewire
# 处理不了 tiled DMA-BUF（pipewire work_item #5353 未修复），而 OBS 用
# libpipewire 直接支持 DMA-BUF，可以正常采集 niri 屏幕。所以屏幕推流走 OBS。
# ---------------------------------------------------------------------------

OBS_CONFIG_DIR = os.path.expanduser("~/.config/obs-studio")


def _obs_user_ini():
    """读 OBS 的 user.ini，拿当前激活的 profile / scene collection 名。"""
    out = {}
    try:
        with open(os.path.join(OBS_CONFIG_DIR, "user.ini"), encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith(("[", ";", "#")):
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError:
        pass
    return out


def obs_profile():
    return _obs_user_ini().get("Profile") or "未命名"


def obs_collection():
    return _obs_user_ini().get("SceneCollection") or "未命名"


def obs_service_path(profile=None):
    profile = profile or obs_profile()
    return os.path.join(OBS_CONFIG_DIR, "basic", "profiles", profile, "service.json")


def write_obs_service(server, key, profile=None):
    """把 bilibili 的推流地址+密钥写进 OBS 当前 profile 的 service.json。"""
    path = obs_service_path(profile)
    data = {
        "type": "rtmp_custom",
        "settings": {
            "server": server,
            "use_auth": False,
            "bwtest": False,
            # bilibili 的推流码以 ? 开头（?streamname=...&key=...），? 必须保留，
            # 否则服务器解析不到参数会拒绝推流。
            "key": key or "",
        },
    }
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, path)
    return path


def obs_running():
    return sh_out(["pgrep", "-x", "obs"]) != ""


# ---------------------------------------------------------------------------
# 推流（ffmpeg + 可选的 gst 采集）
# ---------------------------------------------------------------------------

class Streamer:
    def __init__(self, log_path=LOG_PATH):
        self.log_path = log_path
        self.gst = None
        self.ffmpeg = None
        self.obs = None
        self.started_at = None
        self.portal_fd = None
        self.portal_bus = None
        self.portal_session = None
        self._log = None

    # -- 命令构造 -----------------------------------------------------------

    def _audio_args(self, cfg):
        kind = cfg["audio"].get("source", "desktop")
        ab = int(cfg["audio"].get("bitrate") or 160)
        if kind == "none":
            return []
        dev = pulse_device(kind)
        if not dev:
            return []
        return [
            "-f", "pulse", "-thread_queue_size", "2048", "-i", dev,
            "-c:a", "aac", "-b:a", "%dk" % ab, "-ar", "48000", "-ac", "2",
        ]

    def _encoder_args(self, cfg, width, height, fps):
        enc = cfg["video"].get("encoder") or "libx264"
        vb = int(cfg["video"].get("bitrate") or 3500)
        fps = int(fps)
        gop = fps * 2
        if enc == "h264_nvenc":
            return [
                "-c:v", "h264_nvenc", "-preset", "p4", "-tune", "ll",
                "-rc", "cbr", "-b:v", "%dk" % vb, "-maxrate", "%dk" % vb,
                "-bufsize", "%dk" % (vb * 2),
                "-pix_fmt", "yuv420p", "-g", str(gop), "-r", str(fps),
            ]
        # libx264
        preset = cfg["video"].get("preset") or "veryfast"
        return [
            "-c:v", "libx264", "-preset", preset, "-tune", "zerolatency",
            "-b:v", "%dk" % vb, "-minrate", "%dk" % vb,
            "-maxrate", "%dk" % vb, "-bufsize", "%dk" % (vb * 2),
            "-pix_fmt", "yuv420p", "-g", str(gop), "-r", str(fps),
        ]

    def _rtmp_head(self, rtmp_url):
        return ["-f", "flv", rtmp_url]

    # -- screen：gst pipewiresrc 采集 → 管道 → ffmpeg -----------------------

    def build_screen(self, cfg, rtmp_url, fd, node_id):
        width, height = compute_resolution(cfg)
        fps = int(cfg["video"].get("fps") or 30)
        gst = [
            "gst-launch-1.0", "-q",
            "pipewiresrc", "fd=%d" % fd, "target-object=%d" % node_id,
            "do-timestamp=true",
            "!", "videoconvert", "!", "videoscale",
            "!", "video/x-raw,format=BGRx,width=%d,height=%d,framerate=%d/1"
                 % (width, height, fps),
            "!", "fdsink", "sync=false",
        ]
        ffmpeg = [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info",
            "-stats_period", "2",
            "-f", "rawvideo", "-pix_fmt", "bgr0",
            "-s", "%dx%d" % (width, height),
            "-framerate", str(fps),
            "-thread_queue_size", "2048", "-i", "pipe:0",
        ]
        audio_args = self._audio_args(cfg)
        ffmpeg += audio_args
        ffmpeg += self._encoder_args(cfg, width, height, fps)
        # 只有带音频时才 map 音频流
        if audio_args:
            ffmpeg += ["-map", "0:v:0", "-map", "1:a:0"]
        else:
            ffmpeg += ["-map", "0:v:0"]
        ffmpeg += self._rtmp_head(rtmp_url)
        return gst, ffmpeg

    # -- webcam：v4l2 直接 ffmpeg -------------------------------------------

    def build_webcam(self, cfg, rtmp_url):
        dev = cfg["video"].get("webcam") or "/dev/video0"
        width, height = compute_resolution(cfg)
        fps = int(cfg["video"].get("fps") or 30)
        ffmpeg = [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info",
            "-stats_period", "2",
            "-f", "v4l2", "-input_format", "yuyv422",
            "-video_size", "%dx%d" % (width, height),
            "-framerate", str(fps), "-i", dev,
        ]
        audio_args = self._audio_args(cfg)
        ffmpeg += audio_args
        ffmpeg += self._encoder_args(cfg, width, height, fps)
        if audio_args:
            ffmpeg += ["-map", "0:v:0", "-map", "1:a:0"]
        else:
            ffmpeg += ["-map", "0:v:0"]
        ffmpeg += self._rtmp_head(rtmp_url)
        return None, ffmpeg

    # -- test：lavfi 测试画面（跑通全流程用）--------------------------------

    def build_test(self, cfg, rtmp_url):
        size = cfg["video"].get("test_size") or "1280x720"
        fps = int(cfg["video"].get("fps") or 30)
        w, h = (int(x) for x in size.lower().split("x", 1))
        ffmpeg = [
            "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info",
            "-stats_period", "2", "-re",
            "-f", "lavfi", "-i", "testsrc=size=%s:rate=%d" % (size, fps),
            "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000",
        ]
        ffmpeg += self._encoder_args(cfg, w, h, fps)
        ffmpeg += ["-c:a", "aac", "-b:a", "128k", "-ar", "48000", "-ac", "2"]
        ffmpeg += ["-map", "0:v:0", "-map", "1:a:0"]
        ffmpeg += self._rtmp_head(rtmp_url)
        return None, ffmpeg

    # -- 启动 / 停止 --------------------------------------------------------

    def start(self, gst_cmd, ffmpeg_cmd, pass_fds=None):
        os.makedirs(os.path.dirname(self.log_path), mode=0o700, exist_ok=True)
        self._log = open(self.log_path, "wb")
        if gst_cmd:
            self.gst = subprocess.Popen(
                gst_cmd, stdout=subprocess.PIPE, stderr=self._log,
                pass_fds=pass_fds or (),
            )
            self.ffmpeg = subprocess.Popen(
                ffmpeg_cmd, stdin=self.gst.stdout,
                stdout=self._log, stderr=self._log,
            )
            self.gst.stdout.close()
        else:
            self.ffmpeg = subprocess.Popen(
                ffmpeg_cmd, stdout=self._log, stderr=self._log,
            )
        self.started_at = time.time()

    def alive(self):
        return (self.ffmpeg is not None and self.ffmpeg.poll() is None) or \
               (self.obs is not None and self.obs.poll() is None)

    def uptime(self):
        if not self.started_at:
            return 0
        return int(time.time() - self.started_at)

    def last_stats(self):
        """从日志里抓最后一帧的 ffmpeg 进度。"""
        if not os.path.exists(self.log_path):
            return None
        tail = sh_out(["tail", "-c", "4096", self.log_path])
        for line in reversed(tail.splitlines()):
            if "speed=" in line and "frame=" in line:
                return line.strip()
            if "error" in line.lower() or "failed" in line.lower():
                return line.strip()
        return None

    # -- OBS 模式：写配置 + 启动 OBS 推流 ------------------------------------

    def start_obs(self, server, key):
        profile = obs_profile()
        collection = obs_collection()
        svc = write_obs_service(server, key, profile)
        os.makedirs(os.path.dirname(self.log_path), mode=0o700, exist_ok=True)
        self._log = open(self.log_path, "wb")
        self.obs = subprocess.Popen(
            ["obs", "--startstreaming", "--minimize-to-tray",
             "--profile", profile, "--collection", collection],
            stdout=self._log, stderr=self._log,
        )
        self.started_at = time.time()
        return svc

    def stop(self):
        ff_procs = [p for p in (self.ffmpeg, self.gst) if p is not None]
        obs_procs = [self.obs] if self.obs is not None else []
        # ffmpeg/gst：SIGINT 优雅收尾（写 FLV trailer）
        for p in ff_procs:
            if p.poll() is None:
                try:
                    p.send_signal(signal.SIGINT)
                except Exception:
                    pass
        # OBS：直接 SIGTERM 关闭
        for p in obs_procs:
            if p.poll() is None:
                try:
                    p.terminate()
                except Exception:
                    pass
        deadline = time.time() + 5
        for p in ff_procs + obs_procs:
            while p.poll() is None and time.time() < deadline:
                time.sleep(0.1)
        for p in ff_procs + obs_procs:
            if p.poll() is None:
                try:
                    p.terminate()
                except Exception:
                    pass
        for p in ff_procs + obs_procs:
            try:
                p.wait(timeout=3)
            except Exception:
                try:
                    p.kill()
                except Exception:
                    pass
        if self._log:
            try:
                self._log.close()
            except Exception:
                pass
        self.gst = self.ffmpeg = self.obs = None
        self.started_at = None

    def release_portal(self):
        if self.portal_bus is not None and self.portal_session:
            close_portal_session(self.portal_bus, self.portal_session)
        if self.portal_fd is not None:
            try:
                os.close(self.portal_fd)
            except OSError:
                pass
        self.portal_fd = self.portal_bus = self.portal_session = None


