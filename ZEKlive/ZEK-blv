class BiliControl:
    def __init__(self, script):
        self.script = script

    def run(self, *args, timeout=180):
        cmd = [sys.executable, self.script, *args, "--json"]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True,
                               timeout=timeout, stdin=subprocess.DEVNULL)
        except FileNotFoundError:
            raise ToolError(
                "找不到 bilibili_live_stream 脚本：%s" % self.script,
                hint="用设置菜单（7）指定脚本路径，或把它放到 ~/下载/ 下。",
            )
        except subprocess.TimeoutExpired:
            raise ToolError("脚本执行超时（%ds）" % timeout)
        try:
            data = json.loads(r.stdout)
        except ValueError:
            raise ToolError("脚本输出不是合法 JSON：\n%s\nstderr:\n%s"
                            % (r.stdout[-400:], r.stderr[-400:]))
        if not data.get("ok"):
            err = data.get("error") or {}
            raise ToolError(
                "[%s] %s" % (err.get("kind"), err.get("message")),
                hint=err.get("hint"),
                extra=err,  # 兼容，见下方 raise 处理
            )
        return data.get("data") or {}

    # -- 具体命令 -----------------------------------------------------------

    def login(self):
        return self.run("login")

    def logout(self):
        return self.run("logout")

    def status(self):
        return self.run("status")

    def areas(self, search=None, parent=None):
        args = ["areas"]
        if search:
            args += ["--search", search]
        if parent:
            args += ["--parent", parent]
        return self.run(*args)

    def update(self, title=None, area=None):
        args = ["update"]
        if title:
            args += ["--title", title]
        if area:
            args += ["--area", area]
        return self.run(*args)

    def start(self, title=None, area=None):
        args = ["start"]
        if title:
            args += ["--title", title]
        if area:
            args += ["--area", area]
        return self.run(*args)

    def stop(self):
        return self.run("stop")


def find_script(cfg):
    """返回可用的原脚本路径，找不到返回 None。配置的路径失效时会回退到候选。"""
    if cfg.get("script"):
        p = cfg["script"]
        if os.path.isfile(p):
            return p
        # 配置的路径已失效，继续尝试其它候选
    if os.environ.get("BILI_LIVE_STREAM_BIN"):
        p = os.environ["BILI_LIVE_STREAM_BIN"]
        if os.path.isfile(p):
            return p
    for cand in SCRIPT_CANDIDATES:
        cand = os.path.expanduser(cand)
        if os.path.isfile(cand):
            return cand
    p = shutil.which("bilibili_live_stream")
    return p


