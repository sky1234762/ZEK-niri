def c(text, code):
    """给文本加 ANSI 颜色；非 tty 时原样返回。"""
    if not sys.stdout.isatty():
        return text
    return "\033[%sm%s\033[0m" % (code, text)


def green(t): return c(t, "32")
def yellow(t): return c(t, "33")
def red(t): return c(t, "31")
def cyan(t): return c(t, "36")
def white(t): return c(t, "37")
def bold(t): return c(t, "1")


def sh(cmd, **kw):
    """运行命令，返回 CompletedProcess。失败不抛异常，交给调用方判断。"""
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def sh_out(cmd, **kw):
    r = sh(cmd, **kw)
    return r.stdout.strip() if r.returncode == 0 else ""


def which(name):
    return shutil.which(name)


def load_config():
    # 首次从旧名字 bili-live 迁移配置，避免升级后设置丢失
    old_cfg = os.path.join(os.path.dirname(CONFIG_DIR), "bili-live", "config.json")
    if not os.path.isfile(CONFIG_PATH) and os.path.isfile(old_cfg):
        try:
            os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
            shutil.copy2(old_cfg, CONFIG_PATH)
        except OSError:
            pass
    try:
        with open(CONFIG_PATH, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return json.loads(json.dumps(DEFAULT_CONFIG))
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    # 浅合并两层
    for key, value in data.items():
        if isinstance(value, dict) and isinstance(cfg.get(key), dict):
            cfg[key].update(value)
        else:
            cfg[key] = value
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2)
    os.replace(tmp, CONFIG_PATH)


