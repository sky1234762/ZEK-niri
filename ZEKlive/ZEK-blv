def _pick_stream_url(data):
    """从 start 结果里取主 RTMP 推流地址。"""
    streams = data.get("streams") or []
    for s in streams:
        if s.get("protocol") == "rtmp" and s.get("full_url"):
            return s["full_url"], s
    # 兜底：server + key 拼接
    server = data.get("server")
    key = data.get("stream_key")
    if server and key:
        if key.startswith("?") or server.endswith("/"):
            url = server + key
        else:
            url = server + "/" + key
        return url, {"address": server, "key": key}
    raise ToolError("start 结果里没有推流地址")


