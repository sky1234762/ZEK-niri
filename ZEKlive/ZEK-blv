    print(red("  而且无法静默撤销。]"))
    ans = input(bold("zdjd（y/N）：") + " ").strip().lower()
    return ans in ("y", "yes")


def action_start(ctl, streamer, cfg):
    if streamer.alive():
        print(yellow("已经在推流中（已 %s）。先停止再开新流。" % fmt_duration(streamer.uptime())))
        return

    # 登录检查
    try:
        cur = ctl.status()
    except ToolError as exc:
        print(red("还不能开播：%s" % exc.message))
        if exc.hint:
            print(yellow("  " + exc.hint))
        return

    source = cfg["video"].get("source", "screen")
    print("当前画源：%s" % cyan(source))

    # 可选：改标题 / 分区
    title = input(bold("开播标题（回车保持「%s」）：" % cur.get("title", "")) + " ").strip() or None
    area = input(bold("分区（回车保持当前）：") + " ").strip() or None

    if not _confirm_start():
        print("已取消。")
        return

    # 如果房间处于「直播中」但当前没在推流，是上次残留的开播状态，推流码已失效；
    # 先下播再重开，否则 startLive 会返回旧的（已失效）推流码。
    if cur.get("is_live") and not streamer.alive():
        print(yellow("检测到「直播中」但没有在推流（上次的残留状态），先下播再重新开播。"))
        try:
            ctl.stop()
            time.sleep(2)
        except ToolError as exc:
            print(yellow("  下播失败（忽略）：%s" % exc.message))

    # 1) 开播拿推流码
    print("正在开播并获取推流地址……")
    try:
        data = ctl.start(title=title, area=area)
    except ToolError as exc:
        print(red("开播失败：%s" % exc.message))
        if exc.hint:
            print(yellow("  " + exc.hint))
        qr = (exc.extra.get("detail") or {}).get("qr_image") if hasattr(exc, "extra") else None
        if qr:
            show_qr(qr)
        return

    rtmp_url, prim = _pick_stream_url(data)
    print(green("wkzkbl （直播间 %s" % data.get("room_id")))
    print("  标题：%s" % data.get("title"))
    print("  分区：%s" % data.get("area"))
    if data.get("warning"):
        print(yellow("  " + data["warning"]))

    # 2) 启动推流
    print("正在启动推流（画源：%s）……" % source)
    try:
        if source == "screen":
            # niri 的 screencast 只提供 DMA-BUF，gst-pipewire 采不了，改用 OBS
            server = prim.get("address")
            key = prim.get("key")
            if not server or not key:
                raise ToolError("start 结果里没有 server/key，无法写 OBS 配置")
            if obs_running():
                raise ToolError("OBS 已经在运行，请先关闭它再重新开播（避免配置冲突）。")
            svc = streamer.start_obs(server, key)
            print(green("已写入 OBS 推流配置：%s" % svc))
        elif source == "webcam":
            gst_cmd, ff_cmd = streamer.build_webcam(cfg, rtmp_url)
            streamer.start(gst_cmd, ff_cmd)
        elif source == "test":
            gst_cmd, ff_cmd = streamer.build_test(cfg, rtmp_url)
            streamer.start(gst_cmd, ff_cmd)
        else:
            raise ToolError("未知画源：%s" % source)
    except ToolError as exc:
        print(red("推流启动失败：%s" % exc.message))
        if exc.hint:
            print(yellow("  " + exc.hint))
        print(yellow("直播间已经开播但还没推流，请用「停止推流 & 下播」收尾。"))
        return

    # 给 3 秒看 OBS/ffmpeg 是否立刻退出
    time.sleep(3)
    if streamer.alive():
        print(green("推流中！" + ("（OBS 已启动）" if source == "screen" else "")))
        print(gray_status(streamer))
    else:
        print(red("推流进程退出了，日志见 %s" % streamer.log_path))
        _print_log_tail(streamer.log_path)


def gray_status(streamer):
    line = "已推流 %s · 菜单「5」查看状态 /「6」停止并下播" % fmt_duration(streamer.uptime())
    stats = streamer.last_stats()
    if stats:
        line += "\n  " + stats
    return line


def _print_log_tail(path, n=15):
    if not os.path.exists(path):
        return
    tail = sh_out(["tail", "-n", str(n), path])
    if tail:
        print(cyan("----- 推流日志最后 %d 行 -----" % n))
        print(tail)
        print(cyan("----------------------------"))


